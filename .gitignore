# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go build
/bin/
/tmp/

# Dependency directories
/vendor/

# Go workspace file
go.work

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Data files
*.db
*.db-*
data/*.json
!data/.gitkeep

# Local migration backups may contain billing data.
/backups/

# Generated reports
reports/*.png
!reports/.gitkeep

# Logs
logs/*.log
!logs/.gitkeep

# Exported files
exports/*.xlsx
exports/*.json
!exports/.gitkeep

# Test coverage
*.out
coverage.html

# Build artifacts
dist/
build/

# Local runtime configuration (may contain password hashes or private origins)
config.json
config.local.json
config.*.local.json
*.local.json

# Environment variables and credentials
.env
.env.*
!.env.example
!.env.sample
secrets.json
credentials.json
*.secret

# Private keys, certificates, and keystores
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
*.crt
*.cer
*.der

# Local database sidecars and alternate formats
*.sqlite
*.sqlite3
*.db-wal
*.db-shm

# Old storage package (deprecated)
/storage/

# Docs (generated by default; project reference docs are tracked)
/docs/*
!/docs/project/
!/docs/project/*.md
